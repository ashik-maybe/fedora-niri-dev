[Unit]
Description=Noctalia shell for niri
Documentation=https://github.com/noctalia-dev/noctalia
PartOf=graphical-session.target
Before=graphical-session.target
After=niri.service

[Service]
Type=notify
Slice=session.slice
ExecStart=/usr/bin/noctalia
Restart=on-failure
RestartSec=2

[Install]
WantedBy=niri.service
